# OpenRouter (Primary AI)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Groq (Fallback AI)
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Tavily (Web Search)
# Get from https://tavily.com
TAVILY_API_KEY=tvly-...

# Telegram Bot Token
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# OpenAI (Optional - for voice transcription and text-to-speech)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google APIs (Optional - for vision, calendar, Gmail integration)
# Get from https://cloud.google.com/docs/authentication/api-keys
GOOGLE_API_KEY=...
GOOGLE_OAUTH_TOKEN=...  # OAuth token for Gmail/Calendar access

# Debug mode
# Set to 'true' for verbose logs, 'false' for production
DEBUG_MODE=false

# Voice Message Processing
# transcribe_method: 'openai' (API-based, recommended) or 'local' (self-hosted Whisper)
TRANSCRIBE_METHOD=openai

# Voice Reply Settings
# Set to 'true' to send voice replies in addition to text
SEND_VOICE_REPLIES=false

# Reminder Settings
# Check interval in minutes (how often to check for due reminders)
REMINDER_CHECK_INTERVAL=1
# Maximum reminders per user
REMINDER_MAX_PER_USER=100
# Keep delivered reminders for N days before cleanup
REMINDER_RETENTION_DAYS=30

# GitHub Integration (Optional)
# Get from https://github.com/settings/personal-access-tokens
GITHUB_API_TOKEN=ghp_...
# GitHub username for tool integrations
GITHUB_USERNAME=mastermindrna-hub

# Gmail Integration (Optional)
# Uses GOOGLE_OAUTH_TOKEN above

# Google Calendar Integration (Optional)
# Uses GOOGLE_OAUTH_TOKEN above
CALENDAR_ID=primary

# System Settings
# Maximum API calls per user per minute (rate limiting)
MAX_TOOL_CALLS_PER_MINUTE=5
# Daily cost limit in USD
DAILY_COST_LIMIT=0.50
# Daily message limit
DAILY_MESSAGE_LIMIT=50
